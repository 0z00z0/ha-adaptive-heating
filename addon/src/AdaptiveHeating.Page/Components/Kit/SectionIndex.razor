@* The sticky jump row above the folds. Opening the target fold is the page's job — this only reports which
	one was pressed. *@

<nav class="d2-index" aria-label="@Label">
	@foreach (Item item in Items)
	{
		<button type="button" @onclick="() => Jump(item.Id)">
			@item.Title
			@if (item.BangKind is { Length: > 0 } bangKind)
			{
				<Bang Kind="@bangKind" Title="@(item.BangTitle ?? "")" />
			}
		</button>
	}
</nav>

@code {
	/// <summary>One jump target: a fold's id and title, and the same mark a Fold would show.</summary>
	public sealed record Item(string Id, string Title, string? BangKind = null, string? BangTitle = null);

	[Parameter, EditorRequired]
	public IReadOnlyList<Item> Items { get; set; } = [];

	/// <summary>The accessible name of the jump row.</summary>
	[Parameter, EditorRequired]
	public string Label { get; set; } = "";

	[Parameter]
	public EventCallback<string> OnJump { get; set; }

	private Task Jump(string id) => OnJump.InvokeAsync(id);
}
